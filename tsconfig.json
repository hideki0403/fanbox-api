{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"rootDir": "./src",
		"paths": {
			"@/*": ["./src/*"]
		},
		"plugins": [
			{
				"transform": "@zerollup/ts-transform-paths"
			}
		],
		"resolveJsonModule": true,
		"outDir": "./build",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
